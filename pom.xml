<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>dev.maxenceng</groupId>
	<artifactId>lazyclaude</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>lazyclaude</name>
	<description>A terminal IDE for Claude Code, driven by the docs/backlog board</description>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<main.class>dev.maxenceng.lazyclaude.LazyClaude</main.class>
		<tamboui.version>0.5.0</tamboui.version>
		<junit.version>6.1.3</junit.version>
		<assertj.version>3.27.7</assertj.version>
		<archunit.version>1.5.1</archunit.version>
		<mockito.version>5.20.0</mockito.version>
		<pty4j.version>0.14.0</pty4j.version>
		<jediterm.version>3.76</jediterm.version>
		<dependency-plugin.version>3.9.0</dependency-plugin.version>
		<snakeyaml-engine.version>3.2</snakeyaml-engine.version>
		<jackson.version>3.2.3</jackson.version>
		<compiler.version>3.16.0</compiler.version>
		<surefire.version>3.6.0</surefire.version>
		<shade.version>3.6.2</shade.version>
		<spotless.version>3.10.4</spotless.version>
		<pmd.version>3.28.0</pmd.version>
		<checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
		<checkstyle.version>14.3.0</checkstyle.version>
		<cpd.minimumTokens>80</cpd.minimumTokens>
		<!-- Contract tests need a live claude; `make contract` overrides this on the command line. -->
		<excludedGroups>contract</excludedGroups>
	</properties>

	<repositories>
		<!-- jediterm-core is published here only; pty4j comes from Central, where it is newer. -->
		<repository>
			<id>intellij-dependencies</id>
			<url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>false</enabled></snapshots>
		</repository>
	</repositories>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>dev.tamboui</groupId>
				<artifactId>tamboui-bom</artifactId>
				<version>${tamboui.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>tools.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>${jackson.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>dev.tamboui</groupId>
			<artifactId>tamboui-toolkit</artifactId>
		</dependency>
		<dependency>
			<groupId>dev.tamboui</groupId>
			<artifactId>tamboui-jline3-backend</artifactId>
		</dependency>
		<dependency>
			<groupId>dev.tamboui</groupId>
			<artifactId>tamboui-markdown</artifactId>
		</dependency>
		<dependency>
			<groupId>org.snakeyaml</groupId>
			<artifactId>snakeyaml-engine</artifactId>
			<version>${snakeyaml-engine.version}</version>
		</dependency>
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.pty4j</groupId>
			<artifactId>pty4j</artifactId>
			<version>${pty4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.jediterm</groupId>
			<artifactId>jediterm-core</artifactId>
			<version>${jediterm.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Surefire brings its own launcher; IDE runners resolve it on every run without this. -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>${assertj.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${compiler.version}</version>
				<!-- A warning fails the build (ADR 0045); serial is off since no exception is ever serialised. -->
				<configuration>
					<showWarnings>true</showWarnings>
					<compilerArgs>
						<arg>-Xlint:all,-serial</arg>
						<arg>-Werror</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>${dependency-plugin.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Mockito loaded as an agent, as its docs require, since the JDK will stop letting it self-attach. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${surefire.version}</version>
				<configuration>
					<argLine>-javaagent:${org.mockito:mockito-core:jar} --enable-native-access=ALL-UNNAMED</argLine>
				</configuration>
			</plugin>

			<!-- One runnable jar, so `make run` hands the terminal to the app rather than to Maven. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>${shade.version}</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>lazyclaude</finalName>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${main.class}</mainClass>
									<manifestEntries>
										<Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
									</manifestEntries>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/*/module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<importOrder>
							<order>java,javax,org,com,dev,</order>
						</importOrder>
						<removeUnusedImports/>
						<trimTrailingWhitespace/>
						<endWithNewline/>
					</java>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${checkstyle-plugin.version}</version>
				<!-- The plugin's bundled Checkstyle cannot parse Java 25. -->
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>${checkstyle.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>config/checkstyle.xml</configLocation>
					<consoleOutput>true</consoleOutput>
					<violationSeverity>warning</violationSeverity>
					<includeTestSourceDirectory>false</includeTestSourceDirectory>
				</configuration>
			</plugin>

			<!-- Copy-paste detection, so duplication fails the build rather than a review. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${pmd.version}</version>
				<configuration>
					<minimumTokens>${cpd.minimumTokens}</minimumTokens>
					<printFailingErrors>true</printFailingErrors>
					<rulesets>
						<ruleset>config/pmd-rules.xml</ruleset>
					</rulesets>
					<failurePriority>1</failurePriority>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
