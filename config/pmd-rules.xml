<?xml version="1.0"?>
<ruleset name="lazyclaude"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Review corrections that kept coming back, as rules the build runs.</description>

    <!-- Streams, not loops. A loop whose body throws a checked exception is suppressed, with the reason. -->
    <rule name="UseStreamsNotForLoops"
          language="java"
          message="Use a stream rather than a for loop"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>//ForStatement | //ForeachStatement</value>
            </property>
        </properties>
    </rule>
    <!-- Collections are built by streams, not by mutation (ADR 0032). State a field holds is exempt. -->
    <rule name="BuildCollectionsWithoutMutation"
          language="java"
          message="Build the collection with a stream rather than creating one and adding to it"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//MethodDeclaration//ConstructorCall[ClassType[@SimpleName = ('ArrayList', 'LinkedList', 'ArrayDeque', 'HashSet', 'LinkedHashSet', 'TreeSet', 'EnumSet', 'HashMap', 'LinkedHashMap', 'TreeMap', 'EnumMap')]]
|
//MethodCall[@MethodName = 'forEach']/ArgumentList/LambdaExpression[.//MethodCall[@MethodName = ('add', 'addAll', 'put', 'putAll', 'remove', 'removeAll', 'offer')]]
|
//MethodCall[@MethodName = 'forEach']/ArgumentList/MethodReference[@MethodName = ('add', 'addAll', 'put', 'putAll', 'remove', 'removeAll', 'offer')]
|
//MethodDeclaration//MethodCall[@MethodName = ('add', 'addAll', 'put', 'putAll', 'remove', 'removeAll', 'offer')]
    [VariableAccess[@Name = ancestor::MethodDeclaration[1]/FormalParameters/FormalParameter/VariableId/@Name]]
]]></value>
            </property>
        </properties>
    </rule>
    <!-- A string is named once, as a constant; messages, Assert fields and .formatted templates are exempt (ADR 0044). -->
    <rule name="NameStringLiterals"
          language="java"
          message="Name this string as a static final constant"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//StringLiteral[
    not(ancestor::FieldDeclaration[pmd-java:modifiers() = 'static' and pmd-java:modifiers() = 'final'])
    and not(ancestor::Annotation)
    and not(ancestor::ClassDeclaration[ends-with(@SimpleName, 'Exception')])
    and not(parent::ArgumentList/parent::EnumConstant)
    and not(parent::ArgumentList/parent::MethodCall[TypeExpression/ClassType[@SimpleName = 'Assert']])
    and not(parent::ArgumentList/parent::ConstructorCall[ends-with(ClassType/@SimpleName, 'Exception')])
    and not(parent::MethodCall[@MethodName = 'formatted'])
]
]]></value>
            </property>
        </properties>
    </rule>
    <!-- A count or a size compared to 0 is a question with a name: isEmpty, hasLines (ADR 0044). -->
    <rule name="NameZeroComparisons"
          language="java"
          message="Ask a named question (isEmpty, hasLines...) rather than comparing a count to 0"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//InfixExpression[@Operator = ('>', '<', '>=', '<=', '==', '!=')][NumericLiteral[@ValueAsInt = 0]][MethodCall]
]]></value>
            </property>
        </properties>
    </rule>
</ruleset>
