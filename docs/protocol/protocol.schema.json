{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "title" : "LazyclaudeProtocol",
  "description" : "Every method and notification of the lazyclaude sidecar, generated from its Payloads and Views.",
  "type" : "object",
  "properties" : {
    "methods" : {
      "type" : "object",
      "properties" : {
        "board/boardFor" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/board.BoardPayload"
            },
            "result" : {
              "$ref" : "#/$defs/board.BoardLookupView"
            }
          },
          "required" : [ "params", "result" ],
          "additionalProperties" : false
        },
        "board/watch" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/board.BoardPayload"
            },
            "result" : {
              "$ref" : "#/$defs/board.BoardLookupView"
            }
          },
          "required" : [ "params", "result" ],
          "additionalProperties" : false
        },
        "session/startUnlinked" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.NewHostedPayload"
            },
            "result" : {
              "$ref" : "#/$defs/session.HostStart"
            }
          },
          "required" : [ "params", "result" ],
          "additionalProperties" : false
        },
        "session/startTicket" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.TicketHostedPayload"
            },
            "result" : {
              "$ref" : "#/$defs/session.HostStart"
            }
          },
          "required" : [ "params", "result" ],
          "additionalProperties" : false
        },
        "session/resume" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.ResumeHostedPayload"
            },
            "result" : {
              "$ref" : "#/$defs/session.HostStart"
            }
          },
          "required" : [ "params", "result" ],
          "additionalProperties" : false
        },
        "session/resumeInTicketWorktree" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.ResumeTicketHostedPayload"
            },
            "result" : {
              "$ref" : "#/$defs/session.HostStart"
            }
          },
          "required" : [ "params", "result" ],
          "additionalProperties" : false
        },
        "session/watch" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.SessionPayload"
            },
            "result" : {
              "$ref" : "#/$defs/session.SessionsView"
            }
          },
          "required" : [ "params", "result" ],
          "additionalProperties" : false
        },
        "warning/watch" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/sidecar.NoParams"
            },
            "result" : {
              "$ref" : "#/$defs/shared.WarningsView"
            }
          },
          "required" : [ "params", "result" ],
          "additionalProperties" : false
        }
      },
      "required" : [ "board/boardFor", "board/watch", "session/startUnlinked", "session/startTicket", "session/resume", "session/resumeInTicketWorktree", "session/watch", "warning/watch" ],
      "additionalProperties" : false
    },
    "inputs" : {
      "type" : "object",
      "properties" : {
        "pty/input" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.PtyInputPayload"
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        },
        "pty/resize" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.PtyResizePayload"
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        },
        "session/repaint" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.RepaintPayload"
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        }
      },
      "required" : [ "pty/input", "pty/resize", "session/repaint" ],
      "additionalProperties" : false
    },
    "notifications" : {
      "type" : "object",
      "properties" : {
        "ready" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "type" : "object",
              "properties" : {
                "protocol" : {
                  "const" : 1
                }
              },
              "required" : [ "protocol" ],
              "additionalProperties" : false
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        },
        "board/changed" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/board.BoardReadingView"
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        },
        "session/changed" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.SessionsView"
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        },
        "pty/output" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.PtyOutputView"
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        },
        "session/exited" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/session.SessionExitView"
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        },
        "warning/changed" : {
          "type" : "object",
          "properties" : {
            "params" : {
              "$ref" : "#/$defs/shared.WarningsView"
            }
          },
          "required" : [ "params" ],
          "additionalProperties" : false
        }
      },
      "required" : [ "ready", "board/changed", "session/changed", "pty/output", "session/exited", "warning/changed" ],
      "additionalProperties" : false
    }
  },
  "required" : [ "methods", "inputs", "notifications" ],
  "additionalProperties" : false,
  "$defs" : {
    "board.BoardLookupView" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/board.BoardReadingView"
      }, {
        "$ref" : "#/$defs/board.NoProjectView"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "board.BoardPayload" : {
      "type" : "object",
      "properties" : {
        "from" : {
          "type" : "string"
        }
      },
      "required" : [ "from" ],
      "additionalProperties" : false
    },
    "board.BoardReadingView" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/board.BoardView"
      }, {
        "$ref" : "#/$defs/board.UnavailableBoardView"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "board.BoardView" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "board"
        },
        "groups" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/board.StatusGroupView"
          }
        },
        "unreadable" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/board.UnreadableTicketView"
          }
        },
        "root" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "groups", "unreadable", "root" ],
      "additionalProperties" : false
    },
    "board.Body" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "body"
        },
        "value" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "value" ],
      "additionalProperties" : false
    },
    "board.ContextName" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "contextName"
        },
        "value" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "value" ],
      "additionalProperties" : false
    },
    "board.NoBody" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "noBody"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "board.NoContext" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "noContext"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "board.NoProjectView" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "noProject"
        },
        "reason" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "reason" ],
      "additionalProperties" : false
    },
    "board.NoType" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "noType"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "board.Status" : {
      "type" : "string",
      "enum" : [ "DRAFT", "TODO", "IN_PROGRESS", "IN_REVIEW", "DONE" ]
    },
    "board.StatusGroupView" : {
      "type" : "object",
      "properties" : {
        "status" : {
          "$ref" : "#/$defs/board.Status"
        },
        "tickets" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/board.TicketView"
          }
        }
      },
      "required" : [ "status", "tickets" ],
      "additionalProperties" : false
    },
    "board.TicketBody" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/board.Body"
      }, {
        "$ref" : "#/$defs/board.NoBody"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "board.TicketContext" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/board.ContextName"
      }, {
        "$ref" : "#/$defs/board.NoContext"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "board.TicketType" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/board.TypeName"
      }, {
        "$ref" : "#/$defs/board.NoType"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "board.TicketView" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "branch" : {
          "type" : "string"
        },
        "title" : {
          "type" : "string"
        },
        "status" : {
          "$ref" : "#/$defs/board.Status"
        },
        "context" : {
          "$ref" : "#/$defs/board.TicketContext"
        },
        "type" : {
          "$ref" : "#/$defs/board.TicketType"
        },
        "otherLabels" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "body" : {
          "$ref" : "#/$defs/board.TicketBody"
        },
        "verbs" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/board.Verb"
          }
        }
      },
      "required" : [ "id", "branch", "title", "status", "context", "type", "otherLabels", "body", "verbs" ],
      "additionalProperties" : false
    },
    "board.TypeName" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "typeName"
        },
        "value" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "value" ],
      "additionalProperties" : false
    },
    "board.UnavailableBoardView" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "unavailableBoard"
        },
        "root" : {
          "type" : "string"
        },
        "reason" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "root", "reason" ],
      "additionalProperties" : false
    },
    "board.UnreadableTicketView" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "reason" : {
          "type" : "string"
        }
      },
      "required" : [ "id", "reason" ],
      "additionalProperties" : false
    },
    "board.Verb" : {
      "type" : "string",
      "enum" : [ "REFINE", "START", "REVIEW", "DESIGN", "RESPOND", "DONE" ]
    },
    "session.AiTitle" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "aiTitle"
        },
        "value" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "value" ],
      "additionalProperties" : false
    },
    "session.Busy" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "busy"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "session.ClaudeVersion" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/session.Version"
      }, {
        "$ref" : "#/$defs/session.NoVersion"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "session.FirstPrompt" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "firstPrompt"
        },
        "value" : {
          "type" : "string"
        }
      },
      "required" : [ "kind", "value" ],
      "additionalProperties" : false
    },
    "session.HostStart" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/session.StartedHost"
      }, {
        "$ref" : "#/$defs/session.NotStartedHost"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "session.HostedSessionView" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "pid" : {
          "type" : "integer"
        },
        "live" : {
          "anyOf" : [ {
            "$ref" : "#/$defs/session.LiveSessionView"
          }, {
            "type" : "null"
          } ]
        },
        "busyOrWaiting" : {
          "type" : "boolean"
        },
        "ticket" : {
          "anyOf" : [ {
            "type" : "string"
          }, {
            "type" : "null"
          } ]
        }
      },
      "required" : [ "id", "pid", "live", "busyOrWaiting", "ticket" ],
      "additionalProperties" : false
    },
    "session.LiveSessionView" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "pid" : {
          "type" : "integer"
        },
        "name" : {
          "type" : "string"
        },
        "directory" : {
          "type" : "string"
        },
        "startedAt" : {
          "type" : "string"
        },
        "age" : {
          "type" : "string"
        },
        "version" : {
          "$ref" : "#/$defs/session.ClaudeVersion"
        },
        "state" : {
          "$ref" : "#/$defs/session.SessionState"
        },
        "links" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/session.TicketLink"
          }
        }
      },
      "required" : [ "id", "pid", "name", "directory", "startedAt", "age", "version", "state", "links" ],
      "additionalProperties" : false
    },
    "session.NewHostedPayload" : {
      "type" : "object",
      "properties" : {
        "root" : {
          "type" : "string"
        },
        "size" : {
          "$ref" : "#/$defs/session.PaneSize"
        }
      },
      "required" : [ "root", "size" ],
      "additionalProperties" : false
    },
    "session.NoFirstPrompt" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "noFirstPrompt"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "session.NoTitle" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "noTitle"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "session.NoVersion" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "noVersion"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "session.NoWaitingReason" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "noWaitingReason"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "session.NotStartedHost" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "notStartedHost"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "session.OpeningPrompt" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/session.FirstPrompt"
      }, {
        "$ref" : "#/$defs/session.NoFirstPrompt"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "session.PaneSize" : {
      "type" : "object",
      "properties" : {
        "width" : {
          "type" : "integer"
        },
        "height" : {
          "type" : "integer"
        }
      },
      "required" : [ "width", "height" ],
      "additionalProperties" : false
    },
    "session.PastSessionView" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "title" : {
          "$ref" : "#/$defs/session.SessionTitle"
        },
        "opening" : {
          "$ref" : "#/$defs/session.OpeningPrompt"
        },
        "reading" : {
          "$ref" : "#/$defs/session.TranscriptReading"
        },
        "directory" : {
          "type" : "string"
        },
        "lastActivity" : {
          "type" : "string"
        },
        "age" : {
          "type" : "string"
        },
        "startedAt" : {
          "type" : "string"
        },
        "links" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/session.TicketLink"
          }
        },
        "interrupted" : {
          "type" : "boolean"
        }
      },
      "required" : [ "id", "title", "opening", "reading", "directory", "lastActivity", "age", "startedAt", "links", "interrupted" ],
      "additionalProperties" : false
    },
    "session.PtyInputPayload" : {
      "type" : "object",
      "properties" : {
        "session" : {
          "type" : "string"
        },
        "data" : {
          "type" : "string",
          "contentEncoding" : "base64"
        }
      },
      "required" : [ "session", "data" ],
      "additionalProperties" : false
    },
    "session.PtyOutputView" : {
      "type" : "object",
      "properties" : {
        "session" : {
          "type" : "string"
        },
        "data" : {
          "type" : "string",
          "contentEncoding" : "base64"
        }
      },
      "required" : [ "session", "data" ],
      "additionalProperties" : false
    },
    "session.PtyResizePayload" : {
      "type" : "object",
      "properties" : {
        "session" : {
          "type" : "string"
        },
        "cols" : {
          "type" : "integer"
        },
        "rows" : {
          "type" : "integer"
        }
      },
      "required" : [ "session", "cols", "rows" ],
      "additionalProperties" : false
    },
    "session.ReadableTranscript" : {
      "type" : "object",
      "properties" : {
        "kind" : {
          "const" : "readableTranscript"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "session.RepaintPayload" : {
      "type" : "object",
      "properties" : {
        "session" : {
          "type" : "string"
        }
      },
      "required" : [ "session" ],
      "additionalProperties" : false
    },
    "session.ResumeHostedPayload" : {
      "type" : "object",
      "properties" : {
        "root" : {
          "type" : "string"
        },
        "session" : {
          "type" : "string"
        },
        "recordedDirectory" : {
          "type" : "string"
        },
        "size" : {
          "$ref" : "#/$defs/session.PaneSize"
        }
      },
      "required" : [ "root", "session", "recordedDirectory", "size" ],
      "additionalProperties" : false
    },
    "session.ResumeTicketHostedPayload" : {
      "type" : "object",
      "properties" : {
        "session" : {
          "type" : "string"
        },
        "recordedDirectory" : {
          "type" : "string"
        },
        "root" : {
          "type" : "string"
        },
        "branch" : {
          "type" : "string"
        },
        "size" : {
          "$ref" : "#/$defs/session.PaneSize"
        }
      },
      "required" : [ "session", "recordedDirectory", "root", "branch", "size" ],
      "additionalProperties" : false
    },
    "session.SessionExitView" : {
      "type" : "object",
      "properties" : {
        "session" : {
          "type" : "string"
        },
        "code" : {
          "type" : "integer"
        }
      },
      "required" : [ "session", "code" ],
      "additionalProperties" : false
    },
    "session.SessionPayload" : {
      "type" : "object",
      "properties" : {
        "root" : {
          "type" : "string"
        },
        "ticketIds" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "root", "ticketIds" ],
      "additionalProperties" : false
    },
    "session.SessionState" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/session.Busy"
      }, {
        "$ref" : "#/$defs/session.YourTurn"
      }, {
        "$ref" : "#/$defs/session.WaitingForPermission"
      }, {
        "$ref" : "#/$defs/session.WaitingForInput"
      }, {
        "$ref" : "#/$defs/session.Unknown"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
    "session.SessionTitle" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/session.AiTitle"
      }, {
        "$ref" : "#/$defs/session.FirstPrompt"
      }, {
        "$ref" : "#/$defs/session.NoTitle"
      } ],
      "discriminator" : {
        "propertyName" : "kind"
      }
    },
