{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lazyclaude",
  "version": "0.0.1",
  "identifier": "dev.maxenceng.lazyclaude",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lazyclaude",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
